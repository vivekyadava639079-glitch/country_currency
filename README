/* =========================================================
   4) UTILITIES
   ========================================================= */
function shuffle(arr){
  for(let i=arr.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [arr[i],arr[j]] = [arr[j],arr[i]];
  }
  return arr;
}

function showTab(id){
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active', p.id===id));
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===id));
  window.scrollTo({top:0, behavior:'smooth'});
}

/* =========================================================
   5) NESTED SWITCH — Action handler (सभी functions यहीं से)
   ========================================================= */
function handleAction(action) {
  switch (action.type) {
    case 'navigate':
      switch (action.payload.direction) {
        case 'back':
          navigateBack();
          break;
        case 'forward':
          navigateForward();
          break;
        case 'exit':
          exitQuizConfirm();
          break;
        default:
          console.warn('Unknown navigation:', action.payload.direction);
      }
      break;

    case 'select':
      switch (action.payload.kind) {
        case 'option':
          selectOption(action.payload.index);
          break;
        case 'clear':
          clearSelection();
          break;
        default:
          console.warn('Unknown select kind');
      }
      break;

    case 'submit':
      switch (action.payload.mode) {
        case 'answer':
          submitAnswer();
          break;
        case 'quiz':
          finishQuiz();
          break;
        default:
          console.warn('Unknown submit mode');
      }
      break;

    case 'start':
      switch (action.payload.mode) {
        case 'currency': startQuiz('currency'); break;
        case 'capital':  startQuiz('capital');  break;
        case 'both':     startQuiz('both');     break;
        case 'mixed':    startQuiz('mixed');    break;
        default:         startQuiz('currency');
      }
      break;

    default:
      console.warn('Unknown action type:', action.type);
  }
}

/* =========================================================
   6) NESTED SWITCH — Question generation (mode + type)
   ========================================================= */
function generateQuestionsByMode(mode) {
  const bank = [];
  const allCapitals = COUNTRIES.map(c => c.capital);
  const allCurrencies = COUNTRIES.map(c => `${c.currencyHi} (${c.currencyEn})`);

  switch (mode) {
    case 'currency':
      COUNTRIES.forEach(c => {
        bank.push(makeQuestion({
          q: `देश "${c.country}" की मुद्रा क्या है?`,
          correct: `${c.currencyHi} (${c.currencyEn})`,
          pool: allCurrencies,
          type: 'currency'
        }));
      });
      break;

    case 'capital':
      COUNTRIES.forEach(c => {
        bank.push(makeQuestion({
          q: `देश "${c.country}" की राजधानी क्या है?`,
          correct: c.capital,
          pool: allCapitals,
          type: 'capital'
        }));
      });
      break;

    case 'both':
      COUNTRIES.forEach(c => {
        // Nested switch inside both mode
        switch (true) {
          case true: // capital
            bank.push(makeQuestion({
              q: `देश "${c.country}" की राजधानी क्या है?`,
              correct: c.capital,
              pool: allCapitals,
              type: 'capital'
            }));
            break;
        }
        switch (true) { // currency
          case true:
            bank.push(makeQuestion({
              q: `देश "${c.country}" की मुद्रा क्या है?`,
              correct: `${c.currencyHi} (${c.currencyEn})`,
              pool: allCurrencies,
              type: 'currency'
            }));
            break;
        }
      });
      break;

    case 'mixed':
      COUNTRIES.forEach(c => {
        bank.push(makeQuestion({
          q: `देश "${c.country}" की राजधानी क्या है?`,
          correct: c.capital,
          pool: allCapitals,
          type: 'capital'
        }));
        bank.push(makeQuestion({
          q: `देश "${c.country}" की मुद्रा क्या है?`,
          correct: `${c.currencyHi} (${c.currencyEn})`,
          pool: allCurrencies,
          type: 'currency'
        }));
      });
      SPECIAL_QUESTIONS.forEach(sq => {
        const opts = sq.o.map((text, i) => ({ text, ok: i === sq.a }));
        shuffle(opts);
        bank.push({
          q: sq.q,
          options: opts.map(o => o.text),
          correctIndex: opts.findIndex(o => o.ok),
          type: 'special'
        });
      });
      break;

    default:
      // Nested switch fallback
      switch (mode) {
        case undefined:
        case null:
        case '':
          COUNTRIES.forEach(c => {
            bank.push(makeQuestion({
              q: `देश "${c.country}" की राजधानी क्या है?`,
              correct: c.capital,
              pool: allCapitals,
              type: 'capital'
            }));
          });
          break;
        default:
          console.warn('Unknown mode:', mode);
      }
  }

  return bank;
}

function makeQuestion({ q, correct, pool, type }) {
  const distractors = [];
  const used = new Set([correct]);
  let attempts = 0;
  while (distractors.length < 3 && attempts < 800) {
    attempts++;
    const random = pool[Math.floor(Math.random() * pool.length)];
    if (!used.has(random)) {
      used.add(random);
      distractors.push(random);
    }
  }
  while (distractors.length < 3) distractors.push("अन्य");
  const options = [correct, ...distractors];
  shuffle(options);
  return {
    q, options,
    correctIndex: options.indexOf(correct),
    type
  };
}

/* =========================================================
   7) QUIZ START
   ========================================================= */
function startQuiz(modeId) {
  const modeCfg = QUIZ_MODES[modeId];
  if (!modeCfg) return;

  currentMode = modeCfg;
  currentTimePerQ = modeCfg.timePerQ;

  let bank = generateQuestionsByMode(modeId);
  shuffle(bank);
  quizData = bank.slice(0, modeCfg.count);

  cur = 0; marks = 0;
  nCorrect = 0; nWrong = 0; nSkip = 0;
  review = [];
  quizStartTime = Date.now();
  lockedView = false;

  document.getElementById('quizMenu').style.display = 'none';
  document.getElementById('quizBox').style.display = 'block';
  document.getElementById('scoreLive').textContent = 'अंक: 0';
  document.getElementById('qCounter').textContent = `प्रश्न 1/${quizData.length}`;

  showTab('quiz');
  renderQuestion();
}

/* =========================================================
   8) RENDER QUESTION
   ========================================================= */
function renderQuestion() {
  const q = quizData[cur];
  selected = (review[cur] && review[cur].selectedIdx !== undefined)
    ? review[cur].selectedIdx : null;
  questionDone = !!review[cur];

  document.getElementById('qCounter').textContent = `प्रश्न ${cur+1}/${quizData.length}`;
  document.getElementById('progressBar').style.width = (cur / quizData.length * 100) + '%';
  document.getElementById('questionText').textContent = q.q;

  // Type badge — nested switch
  const badge = document.getElementById('qTypeBadge');
  switch (q.type) {
    case 'currency':
      switch (true) { case true: badge.textContent = '💱 मुद्रा प्रश्न'; badge.style.color = '#4338ca'; break; }
      break;
    case 'capital':
      switch (true) { case true: badge.textContent = '🏛️ राजधानी प्रश्न'; badge.style.color = '#15803d'; break; }
      break;
    case 'special':
      switch (true) { case true: badge.textContent = '⭐ विशेष प्रश्न'; badge.style.color = '#b45309'; break; }
      break;
    default:
      switch (true) { case true: badge.textContent = '❓ प्रश्न'; break; }
  }

  // Options
  const box = document.getElementById('options');
  box.innerHTML = '';
  q.options.forEach((opt, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'opt';
    if (questionDone && i === q.correctIndex) b.classList.add('correct');
    if (questionDone && selected === i && i !== q.correctIndex) b.classList.add('wrong');
    if (selected === i) b.classList.add('sel');
    b.innerHTML = `<span class="badge">${'ABCD'[i]}</span><span>${opt}</span>`;
    b.onclick = () => {
      if (questionDone) return;
      handleAction({ type:'select', payload:{ kind:'option', index:i } });
    };
    box.appendChild(b);
  });

  // Buttons
  const nextBtn = document.getElementById('nextBtn');
  const backBtn = document.getElementById('backBtn');

  backBtn.disabled = (cur === 0);

  if (questionDone) {
    nextBtn.disabled = false;
    nextBtn.textContent = (cur === quizData.length - 1) ? '📊 रिज़ल्ट देखें' : '➡️ अगला प्रश्न';
  } else {
    nextBtn.disabled = (selected === null);
    nextBtn.textContent = '✅ Submit करें';
  }

  // Timer
  if (questionDone) {
    stopTimer();
    document.getElementById('timerBar').style.width = '0%';
    document.getElementById('timerText').textContent = '✔️';
  } else {
    startTimer();
  }
}

/* =========================================================
   9) SELECT / CLEAR
   ========================================================= */
function selectOption(i) {
  if (questionDone) return;
  selected = i;
  document.querySelectorAll('#options .opt').forEach((el, j) => {
    el.classList.toggle('sel', j === i);
  });
  const nextBtn = document.getElementById('nextBtn');
  if (!nextBtn.disabled) return;
  nextBtn.disabled = false;
}

function clearSelection() {
  if (questionDone) return;
  selected = null;
  document.querySelectorAll('#options .opt').forEach(el => el.classList.remove('sel'));
  document.getElementById('nextBtn').disabled = true;
}

/* =========================================================
   10) TIMER
   ========================================================= */
function startTimer() {
  stopTimer();
  timeLeft = currentTimePerQ;
  paintTimer();
  timerId = setInterval(() => {
    timeLeft--;
    paintTimer();
    if (timeLeft <= 0) {
      stopTimer();
      submitAnswer();   // auto-submit on timeout
    }
  }, 1000);
}

function stopTimer() {
  if (timerId) { clearInterval(timerId); timerId = null; }
}

function paintTimer() {
  const pct = Math.max(0, timeLeft) / currentTimePerQ * 100;
  const bar = document.getElementById('timerBar');
  bar.style.width = pct + '%';
  bar.style.background =
      pct > 50 ? 'linear-gradient(90deg,#22c55e,#16a34a)'
    : pct > 25 ? 'linear-gradient(90deg,#f59e0b,#f97316)'
    :            'linear-gradient(90deg,#ef4444,#dc2626)';
  document.getElementById('timerText').textContent = Math.max(0, timeLeft) + 's';
}

/* =========================================================
   11) SUBMIT ANSWER  (Nested switch for status)
   ========================================================= */
function submitAnswer() {
  stopTimer();
  const q = quizData[cur];
  const wasAnswered = !!review[cur];
  const oldStatus = wasAnswered ? review[cur].status : null;
  let newStatus;

  // Decide new status
  if (selected === null) {
    newStatus = 'skip';
  } else if (selected === q.correctIndex) {
    newStatus = 'correct';
  } else {
    newStatus = 'wrong';
  }

  // Nested switch: remove old contribution
  if (wasAnswered) {
    switch (oldStatus) {
      case 'correct':
        switch (true) { case true: marks -= 1; nCorrect--; break; }
        break;
      case 'wrong':
        switch (true) { case true: marks += 1; nWrong--; break; }
        break;
      case 'skip':
        switch (true) { case true: nSkip--; break; }
        break;
      default:
        break;
    }
  }

  // Nested switch: add new contribution
  switch (newStatus) {
    case 'correct':
      switch (true) { case true: marks += 1; nCorrect++; break; }
      break;
    case 'wrong':
      switch (true) { case true: marks -= 1; nWrong++; break; }
      break;
    case 'skip':
      switch (true) { case true: nSkip++; break; }
      break;
    default:
      break;
  }

  // Save review entry
  review[cur] = {
    q: q.q,
    your: selected !== null ? q.options[selected] : null,
    correct: q.options[q.correctIndex],
    status: newStatus,
    selectedIdx: selected,
    type: q.type
  };

  document.getElementById('scoreLive').textContent = 'अंक: ' + marks;

  // Move forward
  if (cur >= quizData.length - 1) {
    finishQuiz();
  } else {
    cur++;
    renderQuestion();
  }
}

/* =========================================================
   12) NAVIGATE BACK / FORWARD
   ========================================================= */
function navigateBack() {
  if (cur === 0) return;
  stopTimer();
  cur--;
  renderQuestion();
}

function navigateForward() {
  if (cur >= quizData.length - 1) return;
  if (questionDone || selected !== null) {
    cur++;
    renderQuestion();
  }
}

/* =========================================================
   13) EXIT QUIZ
   ========================================================= */
function exitQuizConfirm() {
  const ok = confirm('क्या आप Quiz से बाहर जाना चाहते हैं? आपका progress खो जाएगा।');
  if (!ok) return;
  stopTimer();
  document.getElementById('quizBox').style.display = 'none';
  document.getElementById('quizMenu').style.display = 'block';
  quizData = []; review = []; cur = 0;
}

/* =========================================================
   14) FINISH QUIZ + RESULT
   ========================================================= */
function finishQuiz() {
  stopTimer();
  document.getElementById('quizBox').style.display = 'none';
  document.getElementById('quizMenu').style.display = 'block';

  const total = quizData.length;
  const attempted = nCorrect + nWrong;
  const accuracy = attempted ? Math.round(nCorrect / attempted * 100) : 0;
  const maxMarks = total;
  const timeTaken = Math.round((Date.now() - quizStartTime) / 1000);
  const mm = String(Math.floor(timeTaken / 60)).padStart(2, '0');
  const ss = String(timeTaken % 60).padStart(2, '0');

  // Nested switch for verdict
  let vClass = 'v-bad', vText = '';
  switch (true) {
    case (marks >= maxMarks * 0.8):
      switch (true) { case true: vClass = 'v-good'; vText = '🏆 शानदार! तुम्हारी तैयारी बहुत मज़बूत है।'; break; }
      break;
    case (marks >= maxMarks * 0.5):
      switch (true) { case true: vClass = 'v-mid'; vText = '👍 अच्छा प्रयास! थोड़ी और प्रैक्टिस से perfect होगा।'; break; }
      break;
    default:
      switch (true) { case true: vClass = 'v-bad'; vText = '📚 Notes दोबारा पढ़ो और फिर Quiz दो — सुधार कर सकते हो!'; break; }
  }

  let html = `
    <div class="card">
      <h2 style="justify-content:center;text-align:center">📊 परिणाम — ${currentMode ? currentMode.name : ''}</h2>
      <p class="sub" style="text-align:center">कुल ${total} प्रश्न • प्रति गलत −1 अंक</p>
      <div class="verdict ${vClass}">${vText}</div>
      <div class="stats">
        <div class="stat b"><div class="val">${marks} / ${maxMarks}</div><div class="lbl">कुल अंक</div></div>
        <div class="stat g"><div class="val">${nCorrect}</div><div class="lbl">सही ✅</div></div>
        <div class="stat r"><div class="val">${nWrong}</div><div class="lbl">गलत ❌</div></div>
        <div class="stat y"><div class="val">${nSkip}</div><div class="lbl">छोड़े ⏭️</div></div>
        <div class="stat b"><div class="val">${accuracy}%</div><div class="lbl">Accuracy</div></div>
        <div class="stat"><div class="val">${mm}:${ss}</div><div class="lbl">समय</div></div>
      </div>
      <p style="font-size:.86rem;color:#64748b;margin-bottom:6px;text-align:center">
        <b>हिसाब:</b> (सही × +1) − (गलत × 1) = (${nCorrect} × 1) − (${nWrong} × 1) =
        <b style="color:#4338ca">${marks}</b> अंक &nbsp;|&nbsp;
        Attempt: <b>${attempted}</b> / ${total}
      </p>
    </div>

    <div class="card">
      <h2>🔍 प्रश्न-वार समीक्षा (Detailed Review)</h2>
      <p class="sub">अपनी गलतियों से सीखो — यही असली तैयारी है</p>
      <div class="reviewBox">
  `;

  review.forEach((r, i) => {
    if (!r) return;
    const cls = r.status === 'correct' ? 'ok' : r.status === 'wrong' ? 'no' : 'sk';
    const tag = r.status === 'correct'
        ? '<span class="tag ok">सही +1</span>'
        : r.status === 'wrong'
          ? '<span class="tag no">गलत −1</span>'
          : '<span class="tag sk">छोड़ा 0</span>';
    const yourLine = r.your
        ? `<div class="ra">तुम्हारा उत्तर: <i>${r.your}</i></div>`
        : `<div class="ra">तुम्हारा उत्तर: <i>नहीं दिया</i></div>`;
    html += `
      <div class="rev ${cls}">
        <div class="rq">Q${i+1}. ${r.q} ${tag}</div>
        ${yourLine}
        <div class="ra">सही उत्तर: <b>${r.correct}</b></div>
      </div>
    `;
  });

  html += `
      </div>
      <div class="center" style="margin-top:18px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <button class="btn primary" onclick="startQuiz('${currentMode ? currentMode.id : 'currency'}')">🔄 यही Quiz दोबारा</button>
        <button class="btn ghost" onclick="showTab('quiz')">🎯 दूसरा भाग चुनें</button>
        <button class="btn warn" onclick="showTab('notes')">📘 Notes पढ़ें</button>
      </div>
    </div>
  `;

  const box = document.getElementById('resultBox');
  box.className = '';
  box.innerHTML = html;

  showTab('result');
}

/* =========================================================
   15) NOTES RENDER
   ========================================================= */
function renderNotes() {
  const regions = ["एशिया", "मध्य-पूर्व", "यूरोप", "अमेरिका", "अफ्रीका और ओशिनिया"];
  let html = '';

  regions.forEach(region => {
    const list = COUNTRIES.filter(c => c.region === region);
    html += `
      <div class="card">
        <h2>🌍 ${region} के देश</h2>
        <div class="tblwrap">
          <table>
            <thead><tr><th>देश</th><th>राजधानी</th><th>मुद्रा (हिंदी + English)</th></tr></thead>
            <tbody>
    `;
    list.forEach(c => {
      html += `<tr>
        <td>${c.country}</td>
        <td>${c.capital}</td>
        <td class="cur">${c.currencyHi} <span style="color:#64748b;font-weight:400">(${c.currencyEn})</span></td>
      </tr>`;
    });
    html += `</tbody></table></div></div>`;
  });

  const sorted = [...COUNTRIES].sort((a, b) => a.currencyEn.localeCompare(b.currencyEn));
  html += `
    <div class="card">
      <h2>🔤 मुद्रा – वर्णमाला क्रम (A-Z)</h2>
      <p class="sub">English नाम के अनुसार क्रमबद्ध</p>
      <div class="tblwrap">
        <table>
          <thead><tr><th>#</th><th>देश</th><th>मुद्रा (हिंदी)</th><th>मुद्रा (English)</th></tr></thead>
          <tbody>
  `;
  sorted.forEach((c, i) => {
    html += `<tr>
      <td>${i+1}</td><td>${c.country}</td>
      <td class="cur">${c.currencyHi}</td><td>${c.currencyEn}</td>
    </tr>`;
  });
  html += `</tbody></table></div></div>`;

  document.getElementById('notesContainer').innerHTML = html;
}

/* =========================================================
   16) KEYBOARD SHORTCUTS
   ========================================================= */
document.addEventListener('keydown', (e) => {
  if (!document.getElementById('quiz').classList.contains('active')) return;
  if (document.getElementById('quizBox').style.display === 'none') return;

  switch (e.key) {
    case '1': case '2': case '3': case '4': {
      const opts = document.querySelectorAll('#options .opt');
      const idx = parseInt(e.key, 10) - 1;
      if (opts[idx]) opts[idx].click();
      break;
    }
    case 'Enter': {
      const nb = document.getElementById('nextBtn');
      if (!nb.disabled) nb.click();
      break;
    }
    case 'Backspace': {
      e.preventDefault();
      const bb = document.getElementById('backBtn');
      if (!bb.disabled) bb.click();
      break;
    }
    case 'Escape': {
      handleAction({ type:'navigate', payload:{ direction:'exit' } });
      break;
    }
  }
});

/* =========================================================
   17) INIT
   ========================================================= */
window.addEventListener('DOMContentLoaded', () => {
  renderNotes();
});
</script>
</body>
</html>
